{
  "mcpServers": {
    "memory": {
      "command": "memory",
      "args": ["server"]
    },
    "sequential-thinking": {
      "command": "npx",
      "args": ["-y", "@modelcontextprotocol/server-sequential-thinking"]
    },
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    },
    "ide": {
      "command": "uvx",
      "args": ["mcp-ide"]
    },
    "mantic": {
      "command": "bunx",
      "args": ["-y", "mantic.sh@latest", "server"]
    }
  }
}
